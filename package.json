{
  "name": "antigravity-mcp-bridge",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:plugin": "npm run build && node scripts/build-plugin.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:integration": "node tests/real-integration.mjs",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
