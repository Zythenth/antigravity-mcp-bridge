{
  "name": "antigravity-mcp-bridge",
  "version": "0.4.1",
  "description": "Local MCP bridge for the official Antigravity CLI, with isolated project copies and reviewed integration.",
  "repository": { "type": "git", "url": "git+https://github.com/Zythenth/antigravity-mcp-bridge.git" },
  "homepage": "https://github.com/Zythenth/antigravity-mcp-bridge#readme",
  "bugs": { "url": "https://github.com/Zythenth/antigravity-mcp-bridge/issues" },
  "engines": { "node": ">=24" },
  "bin": { "antigravity-mcp-bridge": "bin/antigravity-mcp-bridge.mjs" },
  "files": [
    "bin/antigravity-mcp-bridge.mjs",
    "plugin/server.mjs",
    "plugin/.codex-plugin/plugin.json",
    "plugin/.mcp.json",
    "plugin/skills/antigravity/SKILL.md",
    "plugin/skills/antigravity/agents/openai.yaml",
    "LICENSE", "README.md", "CHANGELOG.md", "PRIVACY.md", "SECURITY.md", "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:plugin": "npm run build && node scripts/build-plugin.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:integration": "node tests/real-integration.mjs",
    "test:package": "node tests/package-integration.mjs",
    "prepack": "npm run build:plugin",
    "start": "node dist/src/index.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.6.5",
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
