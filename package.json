{
  "name": "black-gravity",
  "version": "0.9.0",
  "description": "Black Gravity: an independent local MCP bridge for the official Google Antigravity CLI (agy), with isolated project copies and reviewed integration.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zythenth/black-gravity.git"
  },
  "homepage": "https://github.com/Zythenth/black-gravity#readme",
  "bugs": {
    "url": "https://github.com/Zythenth/black-gravity/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "black-gravity": "bin/black-gravity.mjs"
  },
  "files": [
    "bin/black-gravity.mjs",
    "plugin/server.mjs",
    "plugin/.codex-plugin/plugin.json",
    "plugin/.mcp.json",
    "plugin/skills/black-gravity/SKILL.md",
    "plugin/skills/black-gravity/agents/openai.yaml",
    "plugin/skills/black-gravity/references/",
    "plugin/anti-ai-craft/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "PRIVACY.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-windows-helper.mjs",
    "build:plugin": "npm run build && node scripts/build-plugin.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters -p tsconfig.json",
    "test": "npm run build && node scripts/run-tests.mjs dist/tests/*.test.js",
    "test:integration": "node tests/real-integration.mjs",
    "test:package": "node tests/package-integration.mjs",
    "prepack": "npm run build:plugin",
    "start": "node dist/src/index.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.6.5",
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
